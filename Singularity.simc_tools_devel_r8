Bootstrap: docker
From: rockylinux:8

%runscript
    exec "$@"

%post
    COMPOPT="--nodocs --setopt install_weak_deps=False"
    dnf install -y $COMPOPT epel-release
    dnf install -y 'dnf-command(config-manager)'
    dnf config-manager --set-enabled powertools
    dnf config-manager --set-enabled appstream

    dnf copr enable -y simc/stable
 install smnd packages from simc repository
    dnf install -y $COMPOPT wreport bufr2netcdf dballe arkimet libsim ma_utils eccodes eccodes-simc meteo-vm2-utils dba_qcfilter
# fix for some badly coded airep reports, rewrite bufr table
# https://github.com/ARPA-SIMC/wreport/issues/58
    cp /usr/share/wreport/B0000000000000015000.txt \
     /usr/share/wreport/B0000000000000014000.txt
# debuginfo packages
    dnf install -y $COMPOPT wreport-debuginfo bufr2netcdf-debuginfo dballe-debuginfo arkimet-debuginfo libsim-debuginfo ma_utils-debuginfo eccodes-debuginfo
# devel packages
    dnf install -y $COMPOPT libwreport-devel libdballe-devel libsim-devel eccodes-devel
# building and debugging tools
    dnf install -y $COMPOPT gcc gcc-c++ gcc-gfortran make patch autoconf automake libtool cmake gperf help2man file flex bison git gdb strace valgrind
# save some space
    dnf clean all
    rm -rf /var/lib/{dnf,rpm,yum} /var/cache/*

%environment
    export LOG4C_APPENDER=stderr
    export LOG4C_PRIORITY=info
    export ECCODES_DEFINITION_PATH=/usr/share/eccodes-simc/definitions:/usr/share/eccodes/definitions
    export ECCODES_SAMPLES_PATH=/usr/share/eccodes-simc/samples:/usr/share/eccodes/samples

%help
    This container includes most of the tools developed at SIMC
    together with their debugging symbols, build and debugging tools.
